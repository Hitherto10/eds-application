{
  "name": "03.11 - Grading Scales",
  "item": [
    {
      "name": "List Grading Scales",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/grading-scales"
      },
      "response": []
    },
    {
      "name": "Create Grading Scale with Bands",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Standard\",\n  \"description\": \"Default grading scale\",\n  \"bands\": [\n    {\n      \"label\": \"A+\",\n      \"minPercent\": 97,\n      \"maxPercent\": 100,\n      \"gradePoints\": 4,\n      \"sortOrder\": 0\n    },\n    {\n      \"label\": \"A\",\n      \"minPercent\": 90,\n      \"maxPercent\": 96,\n      \"gradePoints\": 3.7,\n      \"sortOrder\": 1\n    },\n    {\n      \"label\": \"A-\",\n      \"minPercent\": 85,\n      \"maxPercent\": 89,\n      \"gradePoints\": 3.3,\n      \"sortOrder\": 2\n    },\n    {\n      \"label\": \"B+\",\n      \"minPercent\": 80,\n      \"maxPercent\": 84,\n      \"gradePoints\": 3,\n      \"sortOrder\": 3\n    },\n    {\n      \"label\": \"B\",\n      \"minPercent\": 75,\n      \"maxPercent\": 79,\n      \"gradePoints\": 2.7,\n      \"sortOrder\": 4\n    },\n    {\n      \"label\": \"B-\",\n      \"minPercent\": 70,\n      \"maxPercent\": 74,\n      \"gradePoints\": 2.3,\n      \"sortOrder\": 5\n    },\n    {\n      \"label\": \"C+\",\n      \"minPercent\": 65,\n      \"maxPercent\": 69,\n      \"gradePoints\": 2,\n      \"sortOrder\": 6\n    },\n    {\n      \"label\": \"C\",\n      \"minPercent\": 60,\n      \"maxPercent\": 64,\n      \"gradePoints\": 1.7,\n      \"sortOrder\": 7\n    },\n    {\n      \"label\": \"C-\",\n      \"minPercent\": 55,\n      \"maxPercent\": 59,\n      \"gradePoints\": 1.3,\n      \"sortOrder\": 8\n    },\n    {\n      \"label\": \"D+\",\n      \"minPercent\": 50,\n      \"maxPercent\": 54,\n      \"gradePoints\": 1,\n      \"sortOrder\": 9\n    },\n    {\n      \"label\": \"D\",\n      \"minPercent\": 45,\n      \"maxPercent\": 49,\n      \"gradePoints\": 0.7,\n      \"sortOrder\": 10\n    },\n    {\n      \"label\": \"F\",\n      \"minPercent\": 0,\n      \"maxPercent\": 44,\n      \"gradePoints\": 0,\n      \"sortOrder\": 11\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/grading-scales"
      },
      "response": []
    },
    {
      "name": "Get Grading Scale",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/grading-scales/{{gradingScaleId}}"
      },
      "response": []
    },
    {
      "name": "Update Grading Scale",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Standard v2\",\n  \"description\": \"Updated description\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/grading-scales/{{gradingScaleId}}"
      },
      "response": []
    },
    {
      "name": "Delete Grading Scale",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/grading-scales/{{gradingScaleId}}"
      },
      "response": []
    },
    {
      "name": "Set Default Grading Scale",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/grading-scales/{{gradingScaleId}}/set-default"
      },
      "response": []
    },
    {
      "name": "Add Grade Band",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"label\": \"A*\",\n  \"minPercent\": 98,\n  \"maxPercent\": 100,\n  \"gradePoints\": 4.5,\n  \"sortOrder\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/grading-scales/{{gradingScaleId}}/bands"
      },
      "response": []
    },
    {
      "name": "Update Grade Band",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"label\": \"A*\",\n  \"minPercent\": 95,\n  \"maxPercent\": 100,\n  \"gradePoints\": 4.5,\n  \"sortOrder\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/grading-scales/{{gradingScaleId}}/bands/{{bandId}}"
      },
      "response": []
    },
    {
      "name": "Delete Grade Band",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/grading-scales/{{gradingScaleId}}/bands/{{bandId}}"
      },
      "response": []
    }
  ]
},